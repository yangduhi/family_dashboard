{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FamilyDashboardState",
  "type": "object",
  "required": [
    "theme",
    "childName",
    "schoolLabel",
    "departureTime",
    "prepStartTime",
    "stepsCompleted",
    "lastStampedDate",
    "location",
    "soundEnabled",
    "ttsEnabled",
    "customImages"
  ],
  "properties": {
    "theme": {
      "type": "string",
      "enum": ["babyshark", "pororo"],
      "description": "부모 설정 창에서만 전환 가능한 대시보드 테마"
    },
    "childName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "schoolLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "departureTime": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "prepStartTime": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "stepsCompleted": {
      "type": "array",
      "items": { "type": "boolean" },
      "minItems": 4,
      "maxItems": 4
    },
    "lastStampedDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "location": {
      "type": "object",
      "required": ["id", "name", "lat", "lon"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "soundEnabled": { "type": "boolean" },
    "ttsEnabled": { "type": "boolean" },
    "customImages": {
      "type": "object",
      "properties": {
        "mascot": { "type": ["string", "null"], "maxLength": 2000000 },
        "mascot_babyshark": { "type": ["string", "null"], "maxLength": 2000000 },
        "mascot_pororo": { "type": ["string", "null"], "maxLength": 2000000 },
        "stamp": { "type": ["string", "null"], "maxLength": 2000000 },
        "stamp_babyshark": { "type": ["string", "null"], "maxLength": 2000000 },
        "stamp_pororo": { "type": ["string", "null"], "maxLength": 2000000 },
        "step1": { "type": ["string", "null"], "maxLength": 2000000 },
        "step2": { "type": ["string", "null"], "maxLength": 2000000 },
        "step3": { "type": ["string", "null"], "maxLength": 2000000 },
        "step4": { "type": ["string", "null"], "maxLength": 2000000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
